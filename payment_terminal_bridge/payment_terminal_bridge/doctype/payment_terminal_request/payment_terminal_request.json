{
 "doctype": "DocType",
 "name": "Payment Terminal Request",
 "module": "Payment Terminal Bridge",
 "autoname": "hash",
 "allow_rename": 0,
 "engine": "InnoDB",
 "field_order": ["agent", "device_id", "payment_mode", "operation", "original_request", "invoice_type", "invoice_name", "invoice_snapshot", "accounting_payment", "invoice_submitted", "company", "cashier", "currency", "amount_minor", "idempotency_key", "fingerprint", "status", "cancel_requested", "last_claimed_at", "terminal_verified", "agent_attempt_id", "provider_reference", "ecr_reference", "rrn", "stan", "auth_code", "error_code", "result_json"],
 "fields": [
  {"fieldname": "invoice_snapshot", "label": "Invoice Snapshot Hash", "fieldtype": "Data", "read_only": 1},
  {"fieldname": "accounting_payment", "label": "Accounting Payment", "fieldtype": "Link", "options": "Payment Entry", "read_only": 1},
  {"fieldname": "invoice_submitted", "label": "Invoice Submitted After Payment", "fieldtype": "Check", "default": "0", "read_only": 1},
  {"fieldname": "payment_mode", "label": "Payment Mode", "fieldtype": "Link", "options": "Mode of Payment"},
  {"fieldname": "agent", "label": "Agent", "fieldtype": "Link", "options": "Payment Terminal Agent", "reqd": 1, "search_index": 1},
  {"fieldname": "device_id", "label": "Device ID", "fieldtype": "Data", "reqd": 1},
  {"fieldname": "operation", "label": "Operation", "fieldtype": "Select", "options": "sale\nrefund\nreversal", "reqd": 1},
  {"fieldname": "original_request", "label": "Original Request", "fieldtype": "Link", "options": "Payment Terminal Request", "search_index": 1},
  {"fieldname": "invoice_type", "label": "Invoice Type", "fieldtype": "Link", "options": "DocType", "reqd": 1},
  {"fieldname": "invoice_name", "label": "Invoice", "fieldtype": "Dynamic Link", "options": "invoice_type", "reqd": 1, "search_index": 1},
  {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1},
  {"fieldname": "cashier", "label": "Cashier", "fieldtype": "Link", "options": "User", "reqd": 1},
  {"fieldname": "currency", "label": "Currency", "fieldtype": "Link", "options": "Currency", "default": "SAR", "reqd": 1},
  {"fieldname": "amount_minor", "label": "Amount (halalas)", "fieldtype": "Int", "reqd": 1},
  {"fieldname": "idempotency_key", "label": "Idempotency Key", "fieldtype": "Data", "reqd": 1, "unique": 1},
  {"fieldname": "fingerprint", "label": "Request Fingerprint", "fieldtype": "Data", "reqd": 1},
  {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "QUEUED\nREQUEST_SENT\nREFUND_REQUESTED\nREVERSAL_REQUESTED\nPROCESSING\nUNKNOWN\nMANUAL_REVIEW\nAPPROVED\nDECLINED\nCANCELLED\nFAILED\nREFUNDED\nREVERSED", "default": "QUEUED", "reqd": 1, "search_index": 1},
  {"fieldname": "cancel_requested", "label": "Cancellation Requested", "fieldtype": "Check", "default": "0"},
  {"fieldname": "last_claimed_at", "label": "Last Claimed At", "fieldtype": "Datetime", "read_only": 1, "search_index": 1},
  {"fieldname": "terminal_verified", "label": "Terminal Verified (agent attestation)", "fieldtype": "Check", "default": "0"},
  {"fieldname": "agent_attempt_id", "label": "Agent Attempt ID", "fieldtype": "Data"},
  {"fieldname": "provider_reference", "label": "Provider Reference", "fieldtype": "Data"},
  {"fieldname": "ecr_reference", "label": "ECR Reference", "fieldtype": "Data"},
  {"fieldname": "rrn", "label": "RRN", "fieldtype": "Data"},
  {"fieldname": "stan", "label": "STAN", "fieldtype": "Data"},
  {"fieldname": "auth_code", "label": "Authorization Code", "fieldtype": "Data"},
  {"fieldname": "error_code", "label": "Error Code", "fieldtype": "Data"},
  {"fieldname": "result_json", "label": "Allowlisted Result Evidence", "fieldtype": "Code", "options": "JSON", "read_only": 1}
 ],
 "permissions": [{"role": "System Manager", "read": 1}]
}